#
# Systemd service unit for HyperVision ISE Portal.
# Install: cp deploy/hypervision.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now hypervision

[Unit]
Description=HyperVision ISE Portal
After=network.target
Documentation=https://github.com/Jangreenlarsen/ise-endpoint-portal

[Service]
Type=simple
User=hypervision
Group=hypervision
WorkingDirectory=/opt/hypervision/backend

ExecStart=/opt/hypervision/venv/bin/python \
    -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --log-level warning

# Genstart altid — dækker OTA-opdaterings-genstart (pkill / os._exit)
Restart=always
RestartSec=3
TimeoutStopSec=15

# Ingen burst-limit: lad systemd forsøge ubegrænset antal genstarter.
# Uden dette giver systemd op efter 5 crash i 10s (default) og portalen
# forbliver nede. Overvåg i stedet med: journalctl -u hypervision -f
StartLimitBurst=0

# Sikkerhed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/hypervision

# Logging til systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hypervision

[Install]
WantedBy=multi-user.target
